# Run ./demo.sh init to generate unique local credentials. Never commit .env.
DEMO_API_KEY=replace-with-at-least-32-random-characters
DB_PASSWORD=replace-with-at-least-32-random-characters
GATEWAY_READ_KEY=replace-with-at-least-32-random-characters
GATEWAY_WRITE_KEY=replace-with-at-least-32-random-characters
BACKEND_KEY=replace-with-at-least-32-random-characters
# Export OPENAI_API_KEY in the shell before ./demo.sh up; it stays server-side.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Optional override for another OpenAI-compatible provider: LLM_API_KEY=...
GATEWAY_KIND='Local policy simulator'
