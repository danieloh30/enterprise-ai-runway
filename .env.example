# Run ./demo.sh init to generate unique local credentials. Never commit .env.
DEMO_API_KEY=replace-with-at-least-32-random-characters
DB_PASSWORD=replace-with-at-least-32-random-characters
GATEWAY_READ_KEY=replace-with-at-least-32-random-characters
GATEWAY_WRITE_KEY=replace-with-at-least-32-random-characters
BACKEND_KEY=replace-with-at-least-32-random-characters
# Export OPENAI_API_KEY in the shell before ./demo.sh up; it stays server-side.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Optional override for another OpenAI-compatible provider: LLM_API_KEY=...
# ./demo.sh up starts a real IBM DataPower Gateway container in front of the policy
# service; running it accepts the IBM DataPower license. The image is amd64-only and
# runs emulated on Apple Silicon (~1.5 GB one-time pull, 1-3 min boot).
DATAPOWER_IMAGE=icr.io/cpopen/datapower/datapower-limited:10.6.0.0
# DataPower WebGUI (https://127.0.0.1:<port>, default login admin/admin) for the live demo.
DATAPOWER_MGMT_PORT=9090
DATAPOWER_PORT=8788
# DataPower is the default. To skip it and use the bundled Quarkus policy simulator,
# run: GATEWAY_MODE=simulator ./demo.sh up  (keep GATEWAY_MODE/GATEWAY_KIND out of this
# file so that command-line override is not shadowed; the launcher labels the UI per mode).
# Dev Mode and ./demo.sh up connect local browser tabs automatically.
# Set false to require manual presenter-key entry even on localhost.
# LOCAL_AUTO_CONNECT=false
